{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowBoard",
  "version": "1.1.0",
  "identifier": "dev.gongshi.flowboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlowBoard · 共事",
        "width": 1280,
        "height": 850,
        "minWidth": 820,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwNzUzMTM3RTZBMzU5QTEKUldTaFdhUG1OekYxd0dNM0RuVVF3M1BsT09TNDR2c09ZeDIreVh6aXo0b3hLbUNjTXdYNHJDMGoK",
      "endpoints": []
    },
    "hot-update": {
      "enabled": true,
      "pubkeys": [
        "untrusted comment: minisign public key: C0753137E6A359A1\nRWShWaPmNzF1wGM3DnUQw3PlOOS44vsOYx2+yXziz4oxKmCcMwX4rC0j"
      ]
    }
  }
}
