{
  "name": "flowboard-macos",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:desktop && npm run build:cloud",
    "lint": "eslint .",
    "test": "node src/utils.check.ts && node worker/versioned.check.js && node worker/source-chat.check.js && node worker/connection.check.js && node scripts/sw.check.mjs",
    "test:sync": "node scripts/sync.check.mjs",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply flowboard_db --local",
    "dev:worker": "wrangler dev --ip 127.0.0.1 --port 8787",
    "tauri": "tauri",
    "build:desktop": "tsc -b && vite build",
    "build:cloud": "esbuild worker/desktop.js --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/cloudflare/index.js",
    "desktop": "tauri dev",
    "package:macos": "tauri build --target universal-apple-darwin --bundles app",
    "test:release": "node src/utils.check.ts && node worker/versioned.check.js && node worker/updates.check.js && node worker/source-chat.check.js && node worker/connection.check.js && node scripts/sw.check.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tauri-plugin-hot-update-api": "^0.1.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wrangler": "^4.154.0"
  }
}
